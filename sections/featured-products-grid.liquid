{%- comment -%}
  Featured Products Grid Section
  一个可配置的产品展示网格组件，支持:
  - 自定义标题和副标题
  - 选择产品集合
  - 设置显示产品数量
  - 响应式网格布局
  - 自定义颜色和间距
{%- endcomment -%}

{{ 'section-featured-products-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign title = section.settings.title
  assign subtitle = section.settings.subtitle
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile
  assign show_view_all = section.settings.show_view_all
  assign view_all_text = section.settings.view_all_text
  assign color_scheme = section.settings.color_scheme
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<div class="featured-products-grid color-{{ color_scheme }} gradient" style="padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;">
  <div class="page-width">
    {%- if title != blank or subtitle != blank -%}
      <div class="section-header text-center">
        {%- if title != blank -%}
          <h2 class="section-header__title {{ section.settings.heading_size }}">{{ title | escape }}</h2>
        {%- endif -%}
        {%- if subtitle != blank -%}
          <p class="section-header__subtitle">{{ subtitle | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="featured-products-grid__grid grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_mobile }}-col-tablet-down">
        {%- for product in collection.products limit: products_to_show -%}
          <div class="grid__item">
            {% render 'product-card',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              show_quick_add: section.settings.enable_quick_add,
              section_id: section_id
            %}
          </div>
        {%- endfor -%}
      </div>

      {%- if show_view_all and collection.all_products_count > products_to_show -%}
        <div class="center">
          <a href="{{ collection.url }}" class="button button--primary">
            {{ view_all_text | default: '查看全部' }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="featured-products-grid__placeholder">
        <div class="grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_mobile }}-col-tablet-down">
          {%- for i in (1..products_to_show) -%}
            <div class="grid__item">
              <div class="product-card-placeholder">
                <div class="product-card-placeholder__image">
                  {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="product-card-placeholder__content">
                  <h3 class="product-card-placeholder__title">产品标题 {{ forloop.index }}</h3>
                  <p class="product-card-placeholder__price">¥199.00</p>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "产品网格展示",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "精选产品",
      "label": "标题"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "小"
        },
        {
          "value": "h1",
          "label": "中"
        },
        {
          "value": "h0",
          "label": "大"
        }
      ],
      "default": "h1",
      "label": "标题大小"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "发现我们最受欢迎的产品",
      "label": "副标题"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "选择产品集合"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "显示产品数量"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "桌面端列数"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1列"
        },
        {
          "value": "2",
          "label": "2列"
        }
      ],
      "default": "2",
      "label": "移动端列数"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "自适应"
        },
        {
          "value": "portrait",
          "label": "竖版"
        },
        {
          "value": "square",
          "label": "正方形"
        }
      ],
      "default": "adapt",
      "label": "图片比例"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "显示第二张图片"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "显示品牌"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "显示评分"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": true,
      "label": "启用快速添加"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "显示查看全部按钮"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "default": "查看全部产品",
      "label": "按钮文字"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "强调色 1"
        },
        {
          "value": "accent-2",
          "label": "强调色 2"
        },
        {
          "value": "background-1",
          "label": "背景 1"
        },
        {
          "value": "background-2",
          "label": "背景 2"
        },
        {
          "value": "inverse",
          "label": "反色"
        }
      ],
      "default": "background-1",
      "label": "配色方案"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部间距",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部间距",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "产品网格展示",
      "settings": {
        "title": "精选产品",
        "subtitle": "发现我们最受欢迎的产品"
      }
    }
  ]
}
{% endschema %}
